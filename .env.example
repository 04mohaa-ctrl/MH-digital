# MH Digital — Environment Variables
# Copy to .env.local and fill in values

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com (required for live contact form emails)
RESEND_API_KEY=
CONTACT_EMAIL=hello@mhdigital.se

# Optional — Supabase (not needed for static MVP sites)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Analytics
NEXT_PUBLIC_GA_ID=
